<Project Sdk="Microsoft.NET.Sdk">

  <!-- qflat: .NET 10 build of MetadataProcessor.Shared as a library, the counterpart of upstream's
       net472 MetadataProcessor.Core: same assembly name and strong-name key, so the same identity. -->
  <Import Project="..\MetadataProcessor.Net.props" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>nanoFramework.Tools.MetadataProcessor.Core</AssemblyName>
    <RootNamespace>nanoFramework.Tools.MetadataProcessor.Core</RootNamespace>
    <AssemblyTitle>nanoFramework.MetadataProcessor.Core</AssemblyTitle>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\MetadataProcessor.Core\key.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <Import Project="..\MetadataProcessor.Shared\MetadataProcessor.Shared.projitems" Label="Shared" />

  <!--
    NuGet dependencies are added by the user after vetting (qflat CLAUDE.md, "Adding a NuGet package").
    Vetted 2026-11-08; packages.lock.json (here and in Console.Net) must keep these contentHash values:
